# macOS
.DS_Store

# Third-party reference sources (never commit: GPL/LGPL/proprietary, large)
/Amethyst-iOS-main/
/VivecraftMod-Multiloader-26.2/
/vendor/

# Evidence artifacts (manifests are described in VERIFY.md; binaries stay local)
/evidence/

# Durable device-session package (built by scripts/m8_device_package.sh; binaries stay local)
/export/m8-device-package/
/export/m8-device-package.zip

# Build outputs and packaging
/.build/
/artifacts/
/build/
/DerivedData/
**/DerivedData/
**/xcuserdata/
**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
*.ipa
*.tipa
*.app/
*.dSYM/
*.xcresult
.swiftpm/

# Secrets and signing material
*.p12
*.mobileprovision
*.provisionprofile
.env
.secrets/

# XcodeGen-generated projects for probes
runtime/probes/*/*.xcodeproj
# Probe run artifacts (readback images/logs): local only, bundled into evidence/EV-* instead
runtime/probes/*/results/
runtime/probes/*/build/

# Gesture Lab raw recordings (operator hand data stays local; summaries/analysis are tracked)
/export/gesturelab-data/**/*.jsonl
# Derived replay fixtures/evaluations (local analysis aid; regenerate with scripts/m7_lab_replay.sh)
/export/m7-lab-fixtures*/
/export/m7-replay*/
/export/gesturelab-data/rejected/
/export/gesturelab-data/*.log
/export/gesturelab-data/*.md

# device soak artifacts are evidence, not source
/export/soak-*/

# Per-developer identity (device UDID, team ID, signing identity); template: scripts/local.env.example
/scripts/local.env

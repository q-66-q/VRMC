# VRMC pinned versions — single source of truth.
# Changing any pin requires an ADR (see AGENT.md §5 and §10.3).
# Source it from bash:  . ./versions.env

# --- Product ---
VRMC_PRODUCT=VRMC
VRMC_PLATFORM=visionOS
VRMC_MIN_VISIONOS=27.0

# --- Minecraft stack ---
MC_VERSION=26.2
MC_VERSION_TYPE=release
MC_JAVA_MAJOR=25
MC_JAVA_COMPONENT=java-runtime-epsilon
MC_LWJGL=3.4.1
FABRIC_LOADER=0.19.3
VIVECRAFT_VERSION=26.2-1.3.15
VIVECRAFT_LICENSE=LGPL-3.0

# --- Build host toolchain (measured 2026-10-31 on Mac16,7 / M4 Pro) ---
XCODE_VERSION=27.2
XCODE_BUILD=27B52
VISIONOS_SDK=27.2
VISIONOS_SIM_RUNTIME=27.0

# --- Graphics ---
MC_GRAPHICS_API=prefer-vulkan
MOLTENVK_VERSION=TBD
MOLTENVK_PIN=TBD

# --- JVM / JIT ---
OPENJDK_VERSION=25
JRE_UPSTREAM=PojavLauncherTeam/android-openjdk-build-multiarch
JRE_BUILD_STATUS=not-built
JIT_PROTOCOL=JIT26
JIT_PROTOCOL_DETAIL="brk #0xf00d; debugger prepares 16 KiB pages"

# --- Reference sources (not committed) ---
AMETHYST_UPSTREAM=AngelAuraMC/Amethyst-iOS
AMETHYST_PIN=f98c413
AMETHYST_LICENSE=GPL-3.0
PRIOR_ART_BENCHMARK=rebelancap/vivecraft-visionos

# --- Artifact hashes (fill when artifacts exist; never commit the artifacts) ---
MC_VERSION_JSON_SHA256=TBD
VIVECRAFT_JAR_SHA256=TBD
GRAPHICS_NOTE="MC Prefer Vulkan -> MoltenVK (fallback: GL/LTW -> ANGLE)"

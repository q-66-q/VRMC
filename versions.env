# VRMC pinned versions — single source of truth.
# Changing any pin requires an ADR (see AGENT.md §5 and §10.3); ADR-0007 covers the M1 stack changes.
# Source it from bash:  . ./versions.env

# --- Product ---
VRMC_PRODUCT=VRMC
VRMC_PLATFORM=visionOS
VRMC_MIN_VISIONOS=27.0

# --- Minecraft stack ---
MC_VERSION=26.2
MC_VERSION_TYPE=release
MC_JAVA_MAJOR=25
MC_JAVA_COMPONENT=java-runtime-epsilon
MC_LWJGL=3.4.1
FABRIC_LOADER=0.19.3
VIVECRAFT_VERSION=26.2-1.3.15
VIVECRAFT_LICENSE=LGPL-3.0
MC_VERSION_JSON_SHA256=267d4b17134667235223525d3151b8126b066a3347c372d7a0d2474a9f0970f4

# --- Build host toolchain (measured 2026-10-31 on Mac16,7 / M4 Pro) ---
XCODE_VERSION=27.2
XCODE_BUILD=27B52
VISIONOS_SDK=27.2
VISIONOS_SIM_RUNTIME=27.0

# --- Graphics ---
MC_GRAPHICS_API=prefer-vulkan
MOLTENVK_VERSION=1.4.3
MOLTENVK_PIN=source-built-app-bundled
MOLTENVK_SHA256=031986062f238d250155f814061e45f7bab03a94f0c7e20de70dd5f16c46e5ee
GRAPHICS_NOTE="MC Prefer Vulkan -> MoltenVK (fallback: GL/LTW -> ANGLE)"
# Prior pin: MoltenVK 1.4.2 (xros build, EV-0010); EV-0016 verified 5/5+9/9 on 1.4.2.
# 1.4.3 re-verification is an M1 checklist item (ADR-0007).

# --- JVM / JIT ---
OPENJDK_VERSION=25.0.4
JRE_UPSTREAM=PojavLauncherTeam/android-openjdk-build-multiarch
JRE_BUILD_STATUS="relabelled-ios-jre; bundled java-25-openjdk in the source build (no fresh xros build needed)"
JRE_TREE_SHA256=7393cf1a8f1233440541c6193547c0e997d142b988238e8f6afacb359b98917a
JIT_PROTOCOL=JIT26
JIT_PROTOCOL_DETAIL="brk #0xf00d; debugger prepares 16 KiB pages"

# --- M1 device stack (ADR-0007 / Sprint-1 T1) ---
AMETHYST_VERSION=1.2.0
AMETHYST_SOURCE="AngelAuraMC/Amethyst-iOS reference tree (VERSION 1.2.0) + submodules: AFNetworking, DBNumberedSlider, MobileGlues, fishhook"
AMETHYST_BUILD_TREE_SHA256=3d3a7c181b25076f985ac24e2fccd6f3a22dee5af3efbc78cad34f486cefb098
# ^ unsigned Payload app tree before re-signing; signed installs differ by signature bytes.
STIKDEBUG_VERSION=3.2.0
STIKDEBUG_IPA_SHA256=f3b4e1ea39a0b84ced25158c21be8f9c08965bbbe525daf5a18f199b1fc3aced
STIKDEBUG_SCRIPT=amethyst.js
AMETHYST_JS_SHA256=7fb4b14b7a9caa6e4723b9a41125030b15db6e4f7e8fb1d9be41f8be9f0fa9b9
LWJGL_VERSION=3.4.1
LWJGL_JARS_SHA256=e6ff1d07b8146c9671fc790150dc511c65d81ddcd23ef0c33672ac7ea8048c59
LWJGL_NATIVES_SHA256=e5cd4f30523b1f8a1ecd0674c59f531acfee93a0e78f0319ce017fa24483069a
# ^ libs/lwjgl34 and Frameworks/lwjgl34 trees in the source-built app (unsigned Payload).


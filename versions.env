# VRMC pinned versions — single source of truth.
# Changing any pin requires an ADR (see AGENT.md §5 and §10.3).
# Source it from bash:  . ./versions.env

# --- Product ---
VRMC_PRODUCT=VRMC
VRMC_PLATFORM=visionOS
VRMC_MIN_VISIONOS=27.0

# --- Minecraft stack ---
MC_VERSION=26.2
MC_VERSION_TYPE=release
MC_JAVA_MAJOR=25
MC_JAVA_COMPONENT=java-runtime-epsilon
MC_LWJGL=3.4.1
FABRIC_LOADER=0.19.3
VIVECRAFT_VERSION=26.2-1.3.15
VIVECRAFT_LICENSE=LGPL-3.0

# --- Build host toolchain (measured 2026-10-31 on Mac16,7 / M4 Pro) ---
XCODE_VERSION=27.2
XCODE_BUILD=27B52
VISIONOS_SDK=27.2
VISIONOS_SIM_RUNTIME=27.0

# --- Graphics ---
MC_GRAPHICS_API=prefer-vulkan
MOLTENVK_VERSION=1.4.3
MOLTENVK_PIN=Amethyst-1.2.0-bundled
# Prior pin: 1.4.2 (xros build record EV-0010); 1.4.3 is device-proven in EV-0034.
# EV-0016's 5/5 + 9/9 were measured on 1.4.2; re-verify against 1.4.3 at first M1 device use (ADR-0007).

# --- JVM / JIT ---
OPENJDK_VERSION=25
JRE_UPSTREAM=PojavLauncherTeam/android-openjdk-build-multiarch
JRE_BUILD_STATUS=relabelled-ios-jre (Deployed external runtime on D1; no fresh xros build needed for the runtime path, see EV-0022/EV-0024)
JIT_PROTOCOL=JIT26
JIT_PROTOCOL_DETAIL="brk #0xf00d; debugger prepares 16 KiB pages"

# --- M1 device stack (ADR-0007) ---
STIKDEBUG_VERSION=3.2.0
STIKDEBUG_SCRIPT=amethyst.js
AMETHYST_IPA_SHA256=N/A          # M1 route (a): source build; the device-installed 1.2.0 IPA provenance is not on pin
MOLTENVK_143_SHA256=031986062f238d250155f814061e45f7bab03a94f0c7e20de70dd5f16c46e5ee  # bundled libMoltenVK.dylib (1.4.3, platform IOS minos 15.0)
STIKDEBUG_IPA_SHA256=f3b4e1ea39a0b84ced25158c21be8f9c08965bbbe525daf5a18f199b1fc3aced
AMETHYST_JS_SHA256=7fb4b14b7a9caa6e4723b9a41125030b15db6e4f7e8fb1d9be41f8be9f0fa9b9
JRE_TREE_SHA256=06ff09cf2d06cd3d9b0d713f147a56b8c1723c0e7fffc573c7ef3241af055409
LWJGL_JARS_SHA256=f6601d2ad9edf975529b7871a21b3ba0297974e43d576980f46f70eaf855ae6e
AMETHYST_BUILD_TREE_SHA256=d8e7a6f6f95d1b4f5a77e70cae2e64a2ed816a32488070d4b36efd3d9a7c1156  # T4 patched build (dev.vrmc.amethyst, 558 MB)
AMETHYST_SOURCE_NOTE="reference tree VERSION 1.2.0 + submodules; remote main/staging lack the multi-LWJGL files"

# --- Reference sources (not committed) ---
AMETHYST_UPSTREAM=AngelAuraMC/Amethyst-iOS
AMETHYST_PIN=1.2.0
# Prior pin: f98c413 / 1.0-development (EV-0001, EV-0004, EV-0005 retained as historical).
# ADR-0007 records the version change and the EV-0032 JNI analysis.
AMETHYST_LICENSE=GPL-3.0
PRIOR_ART_BENCHMARK=rebelancap/vivecraft-visionos

# --- Artifact hashes (fill when artifacts exist; never commit the artifacts) ---
MC_VERSION_JSON_SHA256=267d4b17134667235223525d3151b8126b066a3347c372d7a0d2474a9f0970f4
VIVECRAFT_JAR_SHA256=TBD
GRAPHICS_NOTE="MC Prefer Vulkan -> MoltenVK (fallback: GL/LTW -> ANGLE)"

+// VRMC M3b (EV-0086 issues 1+2): present the game surface modally over the still-live SwiftUI hosting
+// controller instead of replacing window.rootViewController. Replacing the root destroyed the SwiftUI
+// WindowGroup view, which dropped the scene's persistentSystemOverlays(.hidden) window-chrome
+// preference and the SwiftUI lifecycle subscriptions. A full-screen modal keeps the scene alive (chrome
+// hiding works) and the game surface still covers the window. The legacy root swap is retained behind
+// Documents/vrmc-legacy-root-swap.flag for A/B device testing.
+static UIViewController *vrmcGameSurfaceVC = nil;
+
+static BOOL vrmcDocumentFlag(NSString *name) {
+    NSArray<NSString *> *paths = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES);
+    NSString *path = [paths.firstObject stringByAppendingPathComponent:name];
+    return [[NSFileManager defaultManager] fileExistsAtPath:path];
+}
+
+UIViewController* vrmcCurrentSurfaceViewController(void) {
+    if ([vrmcGameSurfaceVC isKindOfClass:SurfaceViewController.class]) {
+        return vrmcGameSurfaceVC;
+    }
+    return currentVC();
+}

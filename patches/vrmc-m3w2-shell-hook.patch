--- a/Natives/main.m
+++ b/Natives/main.m
@@ -15,6 +15,7 @@
 #import "config.h"
 
 #include <libgen.h>
+#include <dlfcn.h>
 #include <pthread.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -356,6 +357,23 @@
     }
 
     @autoreleasepool {
+        // VRMC M3-W2: run the SwiftUI app-lifecycle shell (visionOS framework) so ImmersiveSpace /
+        // CompositorLayer exist. The shell hosts the existing LauncherSplitViewController and the
+        // immersive renderer; if it cannot be loaded we fall back to the old UIKit lifecycle.
+        NSString *shellPath = [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Frameworks/VRMCShell.framework/VRMCShell"];
+        void *shellHandle = dlopen(shellPath.UTF8String, RTLD_NOW | RTLD_GLOBAL);
+        if (shellHandle != NULL) {
+            typedef int32_t (*vrmc_shell_start_fn)(void);
+            vrmc_shell_start_fn shellStart = (vrmc_shell_start_fn)dlsym(shellHandle, "vrmc_shell_start");
+            if (shellStart != NULL) {
+                NSLog(@"[VRMCShell] starting SwiftUI app-lifecycle shell");
+                return shellStart();
+            }
+            NSLog(@"[VRMCShell] dlsym vrmc_shell_start failed: %s", dlerror());
+        } else {
+            NSLog(@"[VRMCShell] dlopen failed: %s", dlerror());
+        }
+        NSLog(@"[VRMCShell] falling back to UIKit UIApplicationMain");
         return UIApplicationMain(argc, argv, nil, NSStringFromClass([AppDelegate class]));
     }
 }
